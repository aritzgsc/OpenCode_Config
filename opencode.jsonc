{
  "$schema": "https://opencode.ai/config.json",

  // Modelo por defecto de las sesiones (formato proveedor/modelo).
  // Pon el tuyo; en V2 la raíz no conserva "#variant".
  "model": "provider/model",

  // Agente por defecto: el pipeline completo arranca con /init.
  "default_agent": "build",

  // Profundidad 2 = delegación anidada orchestrator -> developer -> expertos.
  "experimental": {
    "subagent_depth": 2
  },

  // Playwright MCP disponible en todas las sesiones.
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": false
      }
    }
  },

  // Catálogo de modelos (Antigravity). Ajusta límites y variants a tu cuenta.
  "providers": {
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": [
            { "id": "low", "settings": { "thinkingLevel": "low" } },
            { "id": "high", "settings": { "thinkingLevel": "high" } }
          ]
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": [
            { "id": "low", "settings": { "thinkingLevel": "low" } },
            { "id": "high", "settings": { "thinkingLevel": "high" } }
          ]
        },
        "antigravity-gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": [
            { "id": "low", "settings": { "thinkingLevel": "low" } },
            { "id": "medium", "settings": { "thinkingLevel": "medium" } },
            { "id": "high", "settings": { "thinkingLevel": "high" } }
          ]
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": [
            { "id": "low", "settings": { "thinkingConfig": { "thinkingBudget": 8192 } } },
            { "id": "max", "settings": { "thinkingConfig": { "thinkingBudget": 32768 } } }
          ]
        }
      }
    }
  },

  // Rutas que el watcher ignora.
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "__pycache__/**",
      "*.pyc",
      "*.log"
    ]
  }
}
