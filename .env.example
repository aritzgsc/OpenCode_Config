# Plantilla pública de configuración — rama `config`.
# Copiar a `.env` y sustituir cada placeholder por el valor real LOCAL.
# `.env` (con valores reales) JAMÁS se versiona: está en `.gitignore`.
#
# Placeholders:
# `***` = secreto
# `tu-dominio*.ngrok-free.dev` = dominio ngrok
# `tu@email.com` = email, si procede
#
# Las 19 claves originales se mantienen.
# Se añaden las claves de la nueva arquitectura Tor + Privoxy.
#
# IMPORTANTE:
# - TOR y Privoxy SOLO se activan cuando OpenCode se lanza mediante el wrapper.
# - OPENCODE_TOR_RATE_LIMIT_ROTATION_ENABLED NO debe ponerse en este fichero:
#   el wrapper la establece temporalmente a `true`.
# - OPENCODE_HTTP_PROXY / OPENCODE_HTTPS_PROXY apuntan a Privoxy.
# - Tor escucha en 9050 (SOCKS5) y 9051 (ControlPort).
# - Privoxy escucha en 8118.
#
# ============================================================
# OPENCODE SERVER
# ============================================================

OPENCODE_SERVER_HOST=127.0.0.1
OPENCODE_SERVER_PORT=58941
OPENCODE_SERVER_URL=https://tu-dominio.ngrok-free.dev
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=***

# ============================================================
# NTFY
# ============================================================

OPENCODE_NTFY_URL=https://tu-dominio-ntfy.ngrok-free.dev
OPENCODE_NTFY_TOPIC=***
OPENCODE_NTFY_USER=***
OPENCODE_NTFY_PASSWORD=***

# ============================================================
# NTFY RELAY / CUESTIONARIO
# ============================================================

OPENCODE_NTFY_RELAY_PORT=58942
OPENCODE_NTFY_RELAY_PUBLIC_URL=https://tu-dominio-cuestionario.ngrok-free.dev
OPENCODE_NTFY_RELAY_BASIC_AUTH_USER=***
OPENCODE_NTFY_RELAY_BASIC_AUTH_PASS=***

OPENCODE_NTFY_QUESTION_TTL_MS=3600000
OPENCODE_NTFY_IDLE_SUPPRESS_MS=0

# ============================================================
# RATE LIMIT
# ============================================================

# Tiempo mínimo entre rotaciones automáticas.
# Evita varios NEWNYM consecutivos por un mismo rate limit.
OPENCODE_RATE_LIMIT_COOLDOWN_MS=60000

# Número máximo de intentos de ejecutar el handler.
OPENCODE_RATE_LIMIT_MAX_ATTEMPTS=3

# Espera entre intentos fallidos.
OPENCODE_RATE_LIMIT_RETRY_DELAY_MS=5000

# Timeout máximo del handler.
OPENCODE_RATE_LIMIT_ATTEMPT_TIMEOUT_MS=20000

# Handler que solicita el nuevo circuito Tor.
# Se puede omitir para usar la ruta por defecto:
# ~/.config/opencode/hooks/rate_limit/rate_limit_handler.bat
#
# OPENCODE_RATE_LIMIT_HANDLER=C:\Users\TU_USUARIO\.config\opencode\hooks\rate_limit\rate_limit_handler.bat

# ============================================================
# TOR
# ============================================================

# Activa la configuración Tor dentro del wrapper.
# El wrapper puede comprobar esta variable al arrancar.
OPENCODE_TOR_ENABLED=true

# Ruta al ejecutable independiente de Tor (little-t Tor).
# Sustituir por la ruta REAL de la instalación local.
OPENCODE_TOR_EXE=C:\Tor\tor.exe

# Ruta al torrc específico de OpenCode.
OPENCODE_TORRC=C:\Users\TU_USUARIO\.config\opencode\torrc

# SOCKS5 de Tor.
OPENCODE_TOR_SOCKS_HOST=127.0.0.1
OPENCODE_TOR_SOCKS_PORT=9050

# ControlPort de Tor.
OPENCODE_TOR_CONTROL_HOST=127.0.0.1
OPENCODE_TOR_CONTROL_PORT=9051

# Contraseña del ControlPort.
# IMPORTANTE: esta debe coincidir con el secreto utilizado
# para generar HashedControlPassword en torrc.
OPENCODE_TOR_CONTROL_PASSWORD=***

# ============================================================
# PRIVOXY / PROXY DE OPENCODE
# ============================================================

# OpenCode -> Privoxy -> Tor.
OPENCODE_HTTP_PROXY=http://127.0.0.1:8118
OPENCODE_HTTPS_PROXY=http://127.0.0.1:8118

# No pasar tráfico local de OpenCode por Tor.
OPENCODE_NO_PROXY=localhost,127.0.0.1,::1